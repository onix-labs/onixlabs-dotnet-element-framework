<Project>
    <PropertyGroup>
        <Version>2.2.0</Version>
        <PackageVersion>2.2.0</PackageVersion>
        <AssemblyVersion>2.2.0</AssemblyVersion>

        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <Authors>ONIXLabs</Authors>
        <NeutralLanguage>en</NeutralLanguage>
        <Copyright>Copyright © ONIXLabs 2020</Copyright>
        <RepositoryUrl>https://github.com/onix-labs/onixlabs-dotnet-element-framework</RepositoryUrl>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>
    <PropertyGroup>
        <!-- The 11.x packages only support net10.0 and later; earlier targets stay on the 10.x line. -->
        <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
        <SourceLinkVersion>11.0.100</SourceLinkVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
        <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
        <SourceLinkVersion>10.0.404</SourceLinkVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="$(SourceLinkVersion)" PrivateAssets="All"/>
    </ItemGroup>
</Project>
